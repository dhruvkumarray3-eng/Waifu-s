# Telegram API credentials (from https://my.telegram.org)
API_ID=your_api_id
API_HASH=your_api_hash

# Telegram Bot Token (from @BotFather)
TOKEN=your_bot_token
# Replit users may use this clearer alias instead of TOKEN.
TELEGRAM_BOT_TOKEN=your_bot_token

# Database configuration
MONGO_URL=mongodb+srv://username:password@cluster.example.mongodb.net/?appName=WaifuBot
BACKUP_MONGO_URL=
DB_NAME=waifucluster

# Logging channel ID/username (errors and logs are sent here)
BOT_LOGGING=-1004378945314

# Character updates / logs channel (Database ID)
DATABASE_ID=-1003784042137

# Support chat / channel for Force Join
FORCE_JOIN=-1003784042137

# Support and Update channel URLs for users
SUPPORT_CHAT=https://t.me/your_support_group
UPDATE_CHAT=https://t.me/mafiaXupdates
# Alias used by the Replit project settings.
CHANNEL_LINK=https://t.me/mafiaXupdates
MUSJ_JOIN=

# Admin user configurations
OWNER_ID=your_owner_id

# ImgBB API Key for character image uploads
IMGBB_API_KEY=your_imgbb_api_key
